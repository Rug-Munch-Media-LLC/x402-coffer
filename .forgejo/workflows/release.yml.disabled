# DISABLED 2026-09-11 — release-please requires the GitHub GraphQL API;
# Forgejo does not implement GraphQL, so the action authenticates against
# api.github.com with a Forgejo token and always fails (Bad credentials).
# Fleet-wide known issue. Releases: tag manually (git tag vN.N.N + push)
# until a Forgejo-native release action is adopted.
name: Release

on:
  push:
    branches: [main]

jobs:
  release-please:
    runs-on: docker-x64
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
      - uses: googleapis/release-please-action@v4
        with:
          token: ${{ secrets.GITHUB_TOKEN }}
          release-type: python
          package-name: x402-coffer
