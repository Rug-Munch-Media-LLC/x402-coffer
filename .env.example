# ─────────────────────────────────────────────────────────────────────────────
# Coffer — self-hosted x402 payment facilitator
# Environment variable reference (.env.example)
#
# Copy to `.env` and fill in your values:
#   cp .env.example .env
#
# The container reads this file via docker-compose (`env_file: .env`).
# At least ONE receiving wallet must be set (X402_WALLET or X402_WALLET_SOLANA
# or X402_WALLET_TRON) or the service fails closed at boot with a clear message.
#
# Canonical reference: docs/COFFER-DEPLOY.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Receiving wallets / networks ─────────────────────────────────────────────
# Canonical EVM receiving address (Base USDC by default). REQUIRED unless a
# per-network wallet below is set. Accepts any EVM address (0x…).
# Required: yes (at least one wallet overall)
X402_WALLET=0x0000000000000000000000000000000000000000

# Per-network EVM receiving addresses. Each overrides X402_WALLET for that
# chain. Optional — falls back to X402_WALLET when unset.
# Base (eip155:8453)
X402_WALLET_BASE=
# Ethereum (eip155:1)
X402_WALLET_ETH=
# Arbitrum (eip155:42161)
X402_WALLET_ARBITRUM=
# Optimism (eip155:10)
X402_WALLET_OPTIMISM=
# Polygon (eip155:137)
X402_WALLET_POLYGON=

# Solana receiving address (base58). Optional.
X402_WALLET_SOLANA=

# TRON receiving address (T…). Optional.
X402_WALLET_TRON=

# ── Self-hosted facilitation / settlement ────────────────────────────────────
# Enable self-hosted settlement (EIP-3009 on EVM, SPL on Solana, TRC-20 on
# TRON). Default: on. Set to 0/false to route only through external
# facilitators.
# Required: no | Default: 1 (true)
X402_SELF_FACILITATE=1

# Private key of the self-facilitator settlement account (EVM). Used to sign
# and broadcast EIP-3009 settlement transactions. KEEP SECRET.
# Required: only if X402_SELF_FACILITATE=1 and you settle EVM payments
X402_SELF_FACILITATOR_KEY=

# JSON-RPC endpoint used by the self-facilitator for EVM settlement.
# Optional — falls back to the per-network X402_EIP7702_RPC_* endpoints.
X402_SELF_FACILITATOR_RPC=

# EIP-7702 self-verify JSON-RPC endpoints (network -> endpoint). Used to read
# transaction receipts for on-chain verification. The suffix is the CAIP-2
# chain id (8453 = Base, 1 = Ethereum, 42161 = Arbitrum).
# Required: no | Defaults: public endpoints (see below)
X402_EIP7702_RPC_8453=https://mainnet.base.org
X402_EIP7702_RPC_1=https://eth.llamarpc.com
X402_EIP7702_RPC_42161=https://arb1.arbitrum.io/rpc

# Solana JSON-RPC endpoint for SPL verification. Optional — uses a public
# endpoint when unset.
X402_SOLANA_RPC=

# Dev-only: skip real on-chain verification and mark everything paid.
# NEVER enable in production.
# Required: no | Default: 0 (false)
X402_OFFLINE_MODE=0

# Replay-nonce TTL in seconds. How long a used EIP-3009 nonce is remembered to
# block replay attacks. Default: 86400 (24h).
# Required: no | Default: 86400
X402_NONCE_TTL=86400

# Redis URL for the shared replay-nonce store. Required for multi-instance /
# multi-worker deployments so nonces are shared across processes. Optional for
# single-instance (in-memory store used instead).
# Required: no (yes for multi-instance)
X402_REDIS_URL=redis://redis:6379/0

# ── External facilitator routing (third-party) ───────────────────────────────
# Coinbase facilitator. Default: enabled.
# Required: no | Default: 1 (true)
X402_COINBASE_ENABLED=1
X402_COINBASE_VERIFY=https://x402.org/facilitator/verify
X402_COINBASE_SETTLE=https://x402.org/facilitator/settle
X402_COINBASE_PRIORITY=1
X402_COINBASE_API_KEY=

# PayAI facilitator. Default: enabled.
# Required: no | Default: 1 (true)
X402_PAYAI_ENABLED=1
X402_PAYAI_VERIFY=https://facilitator.payai.network/verify
X402_PAYAI_SETTLE=https://facilitator.payai.network/settle
X402_PAYAI_PRIORITY=2

# Cloudflare facilitator. Default: disabled.
# Required: no | Default: 0 (false)
X402_CF_ENABLED=0
X402_CF_VERIFY=
X402_CF_SETTLE=
X402_CF_PRIORITY=3

# Default facilitator URL used when no specific facilitator is selected.
# Required: no | Default: https://facilitator.payai.network
X402_FACILITATOR_URL=https://facilitator.payai.network

# ── Protocol / expiry / validation tuning ────────────────────────────────────
# Default network advertised in PaymentRequired (CAIP-2).
# Required: no | Default: eip155:8453
X402_DEFAULT_NETWORK=eip155:8453

# Outbound HTTP timeout (seconds) for facilitator/RPC calls.
# Required: no | Default: 15
X402_TIMEOUT_SECONDS=15

# Payment TTL in seconds — how long a payment authorization stays valid.
# Required: no | Default: 3600
X402_PAYMENT_TTL=3600

# EIP-712 domain name/version used for authorization signing.
# Required: no | Defaults: "USD Coin" / "2"
X402_EIP712_NAME=USD Coin
X402_EIP712_VERSION=2

# Optional JSON pricing table (server-side authoritative pricing).
# Required: no
X402_PRICING_JSON=

# ── Enforcement / burst (legacy routers) ─────────────────────────────────────
# Burst rate limiting for legacy routers.
# Required: no | Defaults: 5 / 60
X402_burst_limit=5
X402_burst_window=60

# ── Secrets / integrations ───────────────────────────────────────────────────
# Password for the wallet vault (if used). KEEP SECRET.
# Required: no
WALLET_VAULT_PASSWORD=

# API key for the RMI MCP integration. KEEP SECRET.
# Required: no
RMI_MCP_API_KEY=

# ── Operator UX (deployable FastAPI app) ─────────────────────────────────────
# Bind host / port for the HTTP server.
# Required: no | Defaults: 0.0.0.0 / 8001
X402_HOST=0.0.0.0
X402_PORT=8001

# Enable debug mode (verbose logging, dev only).
# Required: no | Default: 0 (false)
X402_DEBUG=0
