# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text eol=lf
*.pyi text eol=lf

# TypeScript/JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf

# Shell scripts
*.sh text eol=lf

# YAML/TOML
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Markdown
*.md text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.lock binary
